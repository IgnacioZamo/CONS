---
import { Icon } from 'astro-icon/components'
const features = [{logo:"maletin",
                   title:"Trabajo Rapido",
                   txt:"Optimizamos tiempos sin comprometer calidad, entregando diseños modernos y elegantes en plazos eficientes."},
                   {logo:"money",
                   title:"Economico",
                   txt:"Ofrecemos diseños modernos y elegantes adaptados a tu presupuesto sin sacrificar calidad."},
                    {logo:"volante",
                    title:"Maneje su tiempo",
                    txt:"Nos ajustamos a tus horarios para que disfrutes de un servicio cómodo y eficiente."},
                    {logo:"informe",
                    title:"Resultados",
                    txt:"Garantizamos espacios únicos y funcionales, combinando estilo, creatividad y atención al detalle."},
                    {logo:"carpeta",
                    title:"Facilidades",
                    txt:"Contamos con opciones flexibles que se adaptan a tus necesidades para concretar tu proyecto."},
                    {logo:"almacenamiento",
                    title:"Variedad de opciones",
                    txt:"Brindamos soluciones personalizadas para cada estilo y espacio, asegurando siempre diseños modernos y exclusivos."}
                   ]
---

<section class="py-24 px-4" id="ourfeatures">
    <h1 class="mb-5 text-center font-bold text-xl md:text-2xl lg:text-3xl">Nuestras caracteristicas</h1>
    <p class="mb-24 text-center max-w-5xl mx-auto">Diseñamos espacios modernos y elegantes que transforman tus ambientes. Descubre cómo hacemos realidad tus ideas con creatividad, personalización y atención a cada detalle</p>
    <div class="flex flex-wrap gap-8 justify-center">
        {features.map((icono)=>{
            return(
            <div class="text-center max-w-md ">
                <div class="inline-block p-4 bg-blue-800 rounded-md mb-3">
                    <Icon name={icono.logo} class="text-slate-100 text-5xl "/>
                </div>
                <h3 class="text-center font-bold text-xl mb-2">{icono.title}</h3>
                <p>{icono.txt}</p>
            </div>
            )
        })}
    </div>
</section>